{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ia-cave-a-vin/contrat-n8n/reponse-compte.schema.json",
  "title": "Réponses des points d'entrée /compte",
  "description": "Contrat 2.0 (CPT-01 à CPT-03). code_envoye : réponse de /compte/code. connecte : réponse de /compte/session, seule à porter la clé de session. ok : GET /compte (signé), état du compte et quotas du mois. deconnecte : POST /compte/deconnexion (signé), clé révoquée. erreur : rien n'a changé.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version_contrat",
    "request_id",
    "statut"
  ],
  "properties": {
    "version_contrat": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "statut": {
      "enum": [
        "code_envoye",
        "connecte",
        "ok",
        "deconnecte",
        "erreur"
      ]
    },
    "code_valable_s": {
      "type": "integer",
      "minimum": 1
    },
    "compte": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compte_id",
        "email",
        "statut_compte",
        "quota"
      ],
      "properties": {
        "compte_id": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[A-Za-z0-9._%+'-]+@[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}$"
        },
        "statut_compte": {
          "enum": [
            "gratuit",
            "abonne",
            "bloque"
          ],
          "description": "gratuit : quota mensuel gratuit. abonne : quota étendu (paiement à venir, CPT-04). bloque : aucun accès au flux."
        },
        "quota": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enrichissements_restants_mois",
            "prix_restants_mois"
          ],
          "properties": {
            "enrichissements_restants_mois": {
              "type": "integer",
              "minimum": 0
            },
            "prix_restants_mois": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cle_session": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Seulement dans la réponse connecte : clé HMAC du compte, à ranger dans le stockage sécurisé."
        },
        "cle_expire_le": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "erreur": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "reessayable"
      ],
      "properties": {
        "code": {
          "enum": [
            "requete_invalide",
            "code_invalide",
            "code_expire",
            "auth_invalide",
            "signature_expiree",
            "quota_depasse",
            "interne"
          ]
        },
        "message": {
          "type": "string"
        },
        "reessayable": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "statut": {
            "const": "erreur"
          }
        }
      },
      "then": {
        "required": [
          "erreur"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "statut": {
            "const": "code_envoye"
          }
        }
      },
      "then": {
        "required": [
          "code_valable_s"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "statut": {
            "const": "connecte"
          }
        }
      },
      "then": {
        "required": [
          "compte"
        ],
        "properties": {
          "compte": {
            "required": [
              "cle_session",
              "cle_expire_le"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "statut": {
            "enum": [
              "ok",
              "deconnecte",
              "code_envoye",
              "erreur"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "compte": {
            "not": {
              "required": [
                "cle_session"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "statut": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "compte"
        ]
      }
    }
  ]
}
